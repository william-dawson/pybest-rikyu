 #######################################
 # Maps each backend name to a dict of primitive GPU operations.
 # Adding a new backend requires only a new entry here.
+
 
+# Device-to-host staging for PyTorch.
+#
+# `t.cpu()` allocates a fresh pageable numpy array for every transfer, and
+# `cudaMemcpyAsync` into a pageable destination cannot be served by the DMA
+# engine: the driver stages it through a small bounce buffer with a synchronous
+# CPU memcpy. Measured on GB200, 65.8 GB of device-to-host traffic in a 240 AO
+# RCCSD: 3.22 GB/s that way, 192.7 GB/s into pinned memory -- a factor of 60,
+# with the worst single transfer falling from 701 ms to 2.4 ms.
+#
+# Copying through one reused pinned buffer per dtype costs three cudaHostAlloc
+# calls for a whole calculation instead of one allocation per transfer, and no
+# extra resident memory beyond the largest single transfer.
+#
+# CuPy deliberately does NOT use this: it already stages through a pinned
+# memory pool and reaches 126 GB/s unaided, so interposing on it is a
+# regression (measured +7.5% at 240 AO, +5.2% at 580 AO).
+_PINNED_STAGING: dict = {}
+
+
+def _pinned_staging_view(tensor):
+    """A pinned host view of `tensor`, valid until the next transfer."""
+    import torch
+
+    count = tensor.numel()
+    buffer = _PINNED_STAGING.get(tensor.dtype)
+    if buffer is None or buffer.numel() < count:
+        grow = 0 if buffer is None else 2 * buffer.numel()
+        buffer = torch.empty(
+            max(count, grow), dtype=tensor.dtype, pin_memory=True
+        )
+        _PINNED_STAGING[tensor.dtype] = buffer
+    view = buffer[:count].view(tensor.shape)
+    view.copy_(tensor, non_blocking=True)
+    torch.cuda.synchronize()
+    return view.numpy()
+
+
+def _torch_to_numpy_pinned(tensor):
+    """Device to host through pinned memory, returning an owned array."""
+    return _pinned_staging_view(tensor).copy()
+
+
